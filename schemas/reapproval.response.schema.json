{
  "$defs": {
    "ElectronicSignature": {
      "description": "21 CFR 11.50 signature manifestation, linked to the signed evidence by digest.",
      "properties": {
        "authenticated_at": {
          "format": "date-time",
          "title": "Authenticated At",
          "type": "string"
        },
        "evidence_digest": {
          "title": "Evidence Digest",
          "type": "string"
        },
        "meaning": {
          "$ref": "#/$defs/SignatureMeaning"
        },
        "printed_name": {
          "title": "Printed Name",
          "type": "string"
        },
        "signed_at": {
          "format": "date-time",
          "title": "Signed At",
          "type": "string"
        },
        "signer": {
          "title": "Signer",
          "type": "string"
        },
        "statement": {
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "signer",
        "printed_name",
        "meaning",
        "signed_at",
        "evidence_digest",
        "statement",
        "authenticated_at"
      ],
      "title": "ElectronicSignature",
      "type": "object"
    },
    "ReapprovalStatus": {
      "enum": [
        "pending_signoff",
        "approved",
        "rejected"
      ],
      "title": "ReapprovalStatus",
      "type": "string"
    },
    "SignatureMeaning": {
      "enum": [
        "approval",
        "rejection"
      ],
      "title": "SignatureMeaning",
      "type": "string"
    }
  },
  "$id": "https://github.com/kogunlowo123/cross-lab-ai-validation/schemas/reapproval.response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A validated model version awaiting the medical director's signature.",
  "properties": {
    "decided_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decided At"
    },
    "evidence_digest": {
      "title": "Evidence Digest",
      "type": "string"
    },
    "justification": {
      "title": "Justification",
      "type": "string"
    },
    "model_id": {
      "title": "Model Id",
      "type": "string"
    },
    "policy_decision": {
      "title": "Policy Decision",
      "type": "string"
    },
    "policy_digest": {
      "title": "Policy Digest",
      "type": "string"
    },
    "policy_rules": {
      "items": {
        "type": "string"
      },
      "title": "Policy Rules",
      "type": "array"
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "requested_at": {
      "format": "date-time",
      "title": "Requested At",
      "type": "string"
    },
    "requested_by": {
      "title": "Requested By",
      "type": "string"
    },
    "requested_by_kind": {
      "enum": [
        "user",
        "agent"
      ],
      "title": "Requested By Kind",
      "type": "string"
    },
    "signature": {
      "anyOf": [
        {
          "$ref": "#/$defs/ElectronicSignature"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "site_id": {
      "title": "Site Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ReapprovalStatus",
      "default": "pending_signoff"
    },
    "validation_id": {
      "title": "Validation Id",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "site_id",
    "model_id",
    "version",
    "validation_id",
    "evidence_digest",
    "justification",
    "requested_by",
    "requested_by_kind",
    "requested_at",
    "policy_decision",
    "policy_rules",
    "policy_digest"
  ],
  "title": "ReapprovalRequest",
  "type": "object"
}
